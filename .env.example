# ---- atvloadly -------------------------------------------------------------
# Values below were read from the live instance; change only if it moves.
ATVLOADLY_URL=http://192.168.1.180:5533

# Apple TV "Bedroom" (udid 00008110-00066CCE01C0401E)
ATV_DEVICE_ID=eb9f0c424a6a9077bbf09dc77f16bb60

# md5 of the Apple ID email registered in atvloadly
ATV_ACCOUNT_ID=cc95661575ac824ed87d5e6997757202

# Upstream renamed the bundle at 3.2.6. Both are tracked; the updater learns
# new identifiers automatically and records them in state.json.
NUVIO_BUNDLE_IDS=com.pyksel.nuviotvos,com.nuvio.app.tv

# A free Apple ID keeps only this many sideloaded apps active at once.
MAX_ACTIVE_APPS=3

# ---- GitHub ----------------------------------------------------------------
GITHUB_REPO=bobsupra/NuvioTVOS
# Optional. Unauthenticated polling is fine (ETags make quiet polls free);
# a token only raises the rate limit from 60/hr to 5000/hr.
GITHUB_TOKEN=

# Turns tag "tvos-beta-3.2.5" into version "3.2.5" for comparison.
TAG_VERSION_RE='tvos-beta-(.+)'
IPA_ASSET_RE='.*\.ipa$'
IPA_ASSET_PREFER_RE='unsigned-release\.ipa$'

# ---- scheduling ------------------------------------------------------------
POLL_INTERVAL_MINUTES=30

# Installs only *start* inside this window; one already running is never cut
# short. Use "always" to remove the restriction.
QUIET_WINDOW=04:00-06:00
TZ=Europe/London

MAX_ATTEMPTS=3
BACKOFF_MINUTES=15,60,240
INSTALL_TIMEOUT_MINUTES=20
INSTALL_POLL_SECONDS=15
HTTP_TIMEOUT_SECONDS=30

# Once connectivity returns, report a gap this long between successful GitHub
# checks. The outage itself cannot be reported -- no internet means no Telegram
# either -- so this fires on recovery. 0 disables.
OFFLINE_ALERT_HOURS=6

# ---- notifications ---------------------------------------------------------
# From @BotFather. Get the chat id by messaging the bot then opening
#   https://api.telegram.org/bot<TOKEN>/getUpdates
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ---- behaviour -------------------------------------------------------------
# Refuse to install when no Nuvio record exists in atvloadly. A fresh install
# would consume another slot against the free Apple ID's 3-app limit and could
# silently break one of the other sideloaded apps.
REQUIRE_EXISTING_APP=true

REMOVE_EXTENSIONS=false
DRY_RUN=false
LOG_LEVEL=INFO
STATE_PATH=/data/state.json
